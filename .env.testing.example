APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Copy this file to .env.testing (gitignored) and align DB_* with your local .env.
# Laravel loads .env.testing when APP_ENV=testing (e.g. php artisan migrate:fresh --env=testing).
# PHPUnit sets DB_DATABASE=stone_erp_ai_test in phpunit.xml; keep it consistent here.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=stone_erp_ai_test
DB_USERNAME=stoneerp_app
DB_PASSWORD=your_stoneerp_app_password_here

# Prefer array/sync drivers for tests (optional; phpunit.xml also sets some env vars)
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
MAIL_MAILER=array
