APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Vite / browser: leave empty to call /api on the same origin as the web UI.
# Set to full API origin only when the SPA is served separately (must enable CORS for your app URL).
VITE_API_BASE_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=stone_erp_ai
# PHPUnit uses stone_erp_ai_test (see phpunit.xml). Create that database separately for tests.
DB_USERNAME=stoneerp_app
# Use the stoneerp_app MySQL user password (never the root password or a real secret in this file).
DB_PASSWORD=your_stoneerp_app_password_here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local/demo only — required for DemoUserSeeder (never commit a real password).
DEMO_USER_PASSWORD=

# ERP inventory: warehouses and stock counts are data-driven (warehouses + stock tables).
# Extend sites via php artisan db:seed or your own imports — not hardcoded in app code.

# Minutes before a pending draft PO proposal expires (default 30).
ERP_PO_PROPOSAL_TTL_MINUTES=30

# AI provider (openai, claude, ollama). Default: openai
AI_PROVIDER=openai

# OpenAI (Responses API via openai-php/laravel)
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Docker Compose (optional — use on a machine with Docker)
# -----------------------------------------------------------------------------
#
# The project ships `docker-compose.yml` for app + MySQL + Redis + queue worker.
# Copy `docker/compose.env.example` to `docker/compose.env` (ignored by git), set
# `APP_KEY`, DB and MySQL passwords, then:
#   docker compose --env-file docker/compose.env up -d --build
#
# See docs/PHASE11-DOCKER.md for DB_HOST/REDIS_HOST (Compose service names) and
# the first-run migration/seed sequence. This file stays the source of truth for
# variable names; Windows local development is unchanged.

OPENAI_MODEL=gpt-4o-mini
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_REQUEST_TIMEOUT=30

# Anthropic Claude (Messages API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_REQUEST_TIMEOUT=30
ANTHROPIC_MAX_OUTPUT_TOKENS=1024

# Ollama (local or remote — POST /api/chat with native tool calling)
# AI_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=llama3.1:8b
AI_OLLAMA_TIMEOUT=120
AI_OLLAMA_CONNECT_TIMEOUT=10
AI_OLLAMA_KEEP_ALIVE=5m

# AI tool-calling loop (Phase 6.3)
AI_MAX_TOOL_ITERATIONS=8
AI_MAX_TOOL_CALLS=32

# Conversation context & summaries (Phase 7)
AI_CONTEXT_MAX_MESSAGES=24
AI_CONTEXT_MAX_CHARS=12000
AI_FOLLOW_UP_USE_AI=true
AI_FOLLOW_UP_LONG_MIN_CHARS=90
AI_SUMMARY_MIN_MESSAGES=4
AI_SUMMARY_REFRESH_INTERVAL=10

# Assistant API (Phase 8) — POST /api/assistant
AI_ASSISTANT_MAX_MESSAGE_CHARS=4000
AI_ASSISTANT_RATE_LIMIT=60
AI_ASSISTANT_IDEMPOTENCY_LOCK_SECONDS=120
# Experimental lean prompts for low-resource Ollama (default off; honored only when AI_PROVIDER=ollama):
# AI_ASSISTANT_COMPACT_SYSTEM_INSTRUCTIONS=false
# AI_ASSISTANT_COMPACT_TOOL_DESCRIPTIONS=false
# Require checkStock + ERP-backed slab counts for warehouse inventory questions (default true).
# AI_ASSISTANT_ENFORCE_STOCK_GROUNDING=true
