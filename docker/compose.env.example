# Copy to `docker/compose.env` and adjust (do not commit `docker/compose.env`).
# Use with: docker compose --env-file docker/compose.env up -d
#
# The same file supplies Compose-time variables (e.g. APP_PORT) and container env
# (Laravel + MySQL official image variables).

# --- Host port mapping for the app (http://localhost:APP_PORT) ---
APP_PORT=8080

# --- Laravel (minimal set for Docker networking; matches keys in `.env.example`) ---
APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=stone_erp_ai
DB_USERNAME=stoneerp_app
DB_PASSWORD=choose_a_strong_app_password

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=redis

# Async Ollama assistant (must match config/ai.php defaults)
AI_ASSISTANT_QUEUE_CONNECTION=redis
AI_ASSISTANT_QUEUE=default
AI_ASSISTANT_JOB_TIMEOUT=900
# REDIS_QUEUE_RETRY_AFTER should exceed job timeout (default 960 in config/queue.php)

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# PHPUnit / CI are unchanged; this file is for Docker only.

# Demo users are opt-in — set when running DemoUserSeeder inside the container.
DEMO_USER_PASSWORD=

# AI — optional for bootstrapping. Use a non-empty placeholder so the OpenAI Laravel
# package can resolve the client without a real key; omit or replace when calling live APIs.
AI_PROVIDER=openai
OPENAI_API_KEY=docker-placeholder-not-a-real-key
OPENAI_MODEL=gpt-4o-mini

# --- MySQL 8 official image (database and user are created on first start) ---
MYSQL_ROOT_PASSWORD=choose_a_strong_root_password
MYSQL_DATABASE=stone_erp_ai
MYSQL_USER=stoneerp_app
MYSQL_PASSWORD=choose_a_strong_app_password
